[Unit]
Description=SSEF — Sinhala Story Evaluation Framework web application
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/sinhala-story-eval
ExecStart=/home/ubuntu/sinhala-story-eval/.venv/bin/gunicorn \
    --workers 1 \
    --threads 4 \
    --timeout 120 \
    --bind 127.0.0.1:8000 \
    "app.app:create_app()"
Restart=always
RestartSec=5
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
